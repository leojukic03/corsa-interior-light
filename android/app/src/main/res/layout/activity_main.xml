<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.35"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/interior" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <!-- LIJEVO: status, TID, postavke -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Interior Light"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/muted"
                    android:textSize="15sp" />

                <TextView
                    style="@style/Label"
                    android:text="NA TID-u" />

                <TextView
                    android:id="@+id/nowText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#000000"
                    android:fontFamily="monospace"
                    android:padding="10dp"
                    android:textColor="#7CFFB2"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/volumeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/muted" />


                <TextView
                    android:id="@+id/warn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#FFB27C"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnSettings"
                    style="@style/Btn"
                    android:layout_width="match_parent"
                    android:layout_marginTop="16dp"
                    android:text="⚙  Postavke" />
            </LinearLayout>

            <!-- DESNO: LED kontrole -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPower"
                        style="@style/Btn"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:textSize="20sp" />

                    <Button
                        android:id="@+id/btnWelcome"
                        style="@style/Btn"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="Welcome" />
                </LinearLayout>

                <TextView
                    style="@style/Label"
                    android:text="BOJA" />

                <LinearLayout
                    android:id="@+id/colorRow1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:id="@+id/colorRow2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal" />

                <TextView
                    style="@style/Label"
                    android:text="VLASTITA BOJA" />

                <SeekBar
                    android:id="@+id/hue"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:max="359" />

                <TextView
                    android:id="@+id/brightLabel"
                    style="@style/Label" />

                <SeekBar
                    android:id="@+id/bright"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:max="100" />

                <TextView
                    style="@style/Label"
                    android:text="EFEKT" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnStatic"
                        style="@style/Btn"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="Mirna boja" />

                    <Button
                        android:id="@+id/btnStar"
                        style="@style/Btn"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="Shooting star" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
